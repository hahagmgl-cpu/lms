# 카카오 계정 (티스토리 로그인용) — 실제 값은 .env 파일에 작성 (git에 커밋 금지)
TISTORY_ID=your-kakao-email@example.com
TISTORY_PW=your-password

# 글을 올릴 블로그 주소 (서브도메인만)
TISTORY_BLOG=record7518

# --- 글 생성 API (셋 중 사용할 것만 키 입력) ---
# GPT (OpenAI)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# 제미나이 (Google) — https://aistudio.google.com/apikey 에서 무료 발급
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Claude (Anthropic)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5

# 기본 공급자 지정 (openai | gemini | claude). 생략 시 키가 있는 것 자동 선택
# GEN_PROVIDER=gemini

# (선택) 크로미움 실행 파일 경로를 직접 지정할 때
# CHROME_PATH=/opt/pw-browsers/chromium

# (선택) headless=false 로 브라우저 창을 보면서 실행하려면 0으로
HEADLESS=1
